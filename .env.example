# App Configuration
APP_ENV=development
OCR_ENGINE=mock  # Options: mock, tesseract, paddleocr

# SQLite Database
DATABASE_PATH=data/production_docs.db

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=12345678,87654321

# Google Sheets Integration (Kirim langsung dari bot ke spreadsheet)
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=Dokumen_Produksi
AUTO_SYNC_SHEETS=true  # Set true agar hasil scan bot otomatis dikirim langsung ke Google Sheets

# Storage / Paths
SAMPLES_DIR=data/samples
PROCESSED_DIR=data/processed

